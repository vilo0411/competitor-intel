    {
      "id": 22,
      "start": 70.08,
      "end": 72.68,
      "text": "Khi nhóm này quay đầu, chưa nhóm nào đủ lớn để thay."
    },
    {
      "id": 23,
      "start": 73.22,
      "end": 75.18,
      "text": "Bạn nghĩ VN Index sẽ đi tiếp thế nào"
