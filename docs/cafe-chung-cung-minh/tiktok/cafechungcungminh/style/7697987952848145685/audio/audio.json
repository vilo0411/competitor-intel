      "start": 25.02,
      "end": 28.7,
      "text": "trong khi 441 mã giảm, chỉ 212 mã tăng."
    },
    {
      "id": 7,
      "start": 29.22,
      "end": 30.64,
      "text": "Chỉ số xanh, danh mục đỏ."
    },
    {
      "id": 8,
      "start": 31.22,
      "end": 33.92,
      "text": "VIC từng lập đỉnh 256.100 đồng."
    },
    {
      "id": 9,
      "start": 34.4,
      "end": 36.18,
      "text": "Cộn hóa Vingroup gần 2 triệu tỷ đồng."
    },
    {
      "id": 10,
      "start": 36.6,
      "end": 38.18,
      "text": "Lần đầu tiên có doanh nghiệp chạm mốc này."
    },
    {
      "id": 11,
      "start": 38.66,
      "end": 40.26,
      "text": "Nhưng tháng 10 cho thấy mặt còn lại."
    },
    {
      "id": 12,
      "start": 40.84,
      "end": 44.08,
      "text": "Phiên 14 tháng 10, VN Index giảm 14,55 điểm."
    },
    {
      "id": 13,
      "start": 44.54,
      "end": 47.4,
      "text": "Riêng VIC và VHM lấy đi hơn 11 điểm."
    },
    {
      "id": 14,
      "start": 47.94,
      "end": 50.6,
      "text": "VHM về 61.000 đồng, thấp nhất 6 tháng."
    },
    {
      "id": 15,
      "start": 51.14,
      "end": 54.22,
      "text": "Phiên 16 tháng 10, VHM kéo lên 3,56 điểm."
    },
    {
      "id": 16,
      "start": 54.62,
      "end": 56.6,
      "text": "VIC lấy đi 4,81 điểm."
    },
    {
      "id": 17,
      "start": 57.1,
      "end": 59.08,
      "text": "Hai mã cùng nhà, hai chiều ngược nhau."
    },
    {
      "id": 18,
      "start": 59.62,
      "end": 62.16,
      "text": "Trong khi đó, thanh khoản chưa tới 12.000 tỷ đồng."
    },
    {
      "id": 19,
      "start": 62.58,
      "end": 64.32,
      "text": "Khối ngoại bán dòng 11 phiên liên tiếp."
    },
    {
      "id": 20,
      "start": 64.84,
      "end": 67.0,
      "text": "Nói thẳng, họ Ving không chỉ đỡ thị trường."
