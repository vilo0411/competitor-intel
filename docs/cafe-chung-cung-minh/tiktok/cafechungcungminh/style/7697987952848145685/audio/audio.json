    {
      "id": 2,
      "start": 9.86,
      "end": 11.98,
      "text": "Sáng 2026, vẫn như vậy."
    },
    {
      "id": 3,
      "start": 12.54,
      "end": 16.58,
      "text": "6 tháng đầu năm, vốn hóa toàn thị trường tăng thêm khoảng 714.000 tỷ đồng."
    },
    {
      "id": 4,
      "start": 17.1,
      "end": 21.1,
      "text": "Riêng Vingroup và Vinhomes chiếm hơn 500.000 tỷ, khoảng 70%."
    },
    {
      "id": 5,
      "start": 21.1,
      "end": 25.02,
      "text": "Ngày 16 tháng 4, giữa phiên chiều, nhóm VIN kéo hơn 27 điểm"
