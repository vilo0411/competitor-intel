{
  "engine": "whisper-cli",
  "language": "vi",
  "text": "Mẹo nhìn động thái của Ngân hàng Nhà nước để dự đoán hướng đi của thị trường chứng khoán Dân chơi chứng khoán chuyên nghiệp không bao giờ ngồi đoán già đoán non bảng điện ngày mai xanh hay đỏ Họ chỉ nhìn vào một thứ duy nhất, ý chí của Ngân hàng Nhà nước Muốn biết dòng tiền thông minh sắp đổ vào đâu? Hãy theo dõi sát sao hai chỉ số vĩ mô cực kỳ dễ kiếm trên báo chí Lãi suất và tỷ giá Công thức nằm lòng cho dân lười Lãi suất giảm, tỷ giá ổn định bằng chứng khoán là vua Lúc này tiền rẻ, tha hồ đi đầu tư Lãi suất tăng, tỷ giá căng thẳng bằng tiền mặt là vua Lúc này nên rút lui, gửi tiết kiệm phòng thủ Tại sao phải nhìn cả tỷ giá? Nếu đô la Mỹ trên Việt Nam đồng tăng quá cao Khối ngoại, các quỹ đầu tư nước ngoài sẽ bị lỗ tỷ giá khi quy tiền từ đồng ra đô Họ sẽ có xu hướng bán tháo cổ phiếu Việt Nam để rút tiền về nước Khi các ông Tây xả hàng nghìn tỷ mỗi phiên Thị trường chứng khoán rất khó để ngóc đầu lên nổi Tư duy thực tế cho người lười Đầu tư chứng khoán mà không hiểu về chính sách tiền tệ của ngân hàng nhà nước Giống như việc bạn lái xe trong đêm bắt đèn vậy Thay vì mất thời gian đi nghe ngóng phím hàng 3 chữ cái ở các hội nhóm Hãy tập thói quen đọc báo tài chính Xem ngân hàng nhà nước đang muốn bơm tiền hay hút tiền Nương theo dòng chảy của chùm cuối Bạn sẽ luôn ở thế chủ động Follow kênh để không bỏ lỡ những câu chuyện kinh tế tài chính đáng chú ý mỗi ngày nhé",
  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 3.62,
      "text": "Mẹo nhìn động thái của Ngân hàng Nhà nước để dự đoán hướng đi của thị trường chứng khoán"
    },
    {
      "id": 1,
      "start": 3.62,
      "end": 8.8,
      "text": "Dân chơi chứng khoán chuyên nghiệp không bao giờ ngồi đoán già đoán non bảng điện ngày mai xanh hay đỏ"
    },
    {
      "id": 2,
      "start": 8.8,
      "end": 12.28,
      "text": "Họ chỉ nhìn vào một thứ duy nhất, ý chí của Ngân hàng Nhà nước"
    },
    {
      "id": 3,
      "start": 12.28,
      "end": 14.62,
      "text": "Muốn biết dòng tiền thông minh sắp đổ vào đâu?"
    },
    {
      "id": 4,
      "start": 15.02,
      "end": 18.48,
      "text": "Hãy theo dõi sát sao hai chỉ số vĩ mô cực kỳ dễ kiếm trên báo chí"
    },
    {
      "id": 5,
      "start": 18.48,
      "end": 20.08,
      "text": "Lãi suất và tỷ giá"
    },
    {
      "id": 6,
      "start": 20.08,
      "end": 22.1,
      "text": "Công thức nằm lòng cho dân lười"
    },
    {
      "id": 7,
      "start": 22.1,
      "end": 25.58,
      "text": "Lãi suất giảm, tỷ giá ổn định bằng chứng khoán là vua"
    },
    {
      "id": 8,
      "start": 25.58,
      "end": 28.22,
      "text": "Lúc này tiền rẻ, tha hồ đi đầu tư"
    },
    {
      "id": 9,
      "start": 28.22,
      "end": 31.82,
      "text": "Lãi suất tăng, tỷ giá căng thẳng bằng tiền mặt là vua"
    },
    {
      "id": 10,
      "start": 31.82,
      "end": 34.5,
      "text": "Lúc này nên rút lui, gửi tiết kiệm phòng thủ"
    },
    {
      "id": 11,
      "start": 34.5,
      "end": 36.44,
      "text": "Tại sao phải nhìn cả tỷ giá?"
    },
    {
      "id": 12,
      "start": 37.12,
      "end": 39.48,
      "text": "Nếu đô la Mỹ trên Việt Nam đồng tăng quá cao"
    },
    {
      "id": 13,
      "start": 39.48,
      "end": 43.66,
      "text": "Khối ngoại, các quỹ đầu tư nước ngoài sẽ bị lỗ tỷ giá khi quy tiền từ đồng ra đô"
    },
    {
      "id": 14,
      "start": 43.66,
      "end": 47.14,
      "text": "Họ sẽ có xu hướng bán tháo cổ phiếu Việt Nam để rút tiền về nước"
    },
    {
      "id": 15,
      "start": 47.14,
      "end": 49.72,
      "text": "Khi các ông Tây xả hàng nghìn tỷ mỗi phiên"
    },
    {
      "id": 16,
      "start": 49.72,
      "end": 52.16,
      "text": "Thị trường chứng khoán rất khó để ngóc đầu lên nổi"
    },
    {
      "id": 17,
      "start": 52.16,
      "end": 54.24,
      "text": "Tư duy thực tế cho người lười"
    },
    {
      "id": 18,
      "start": 54.24,
      "end": 57.88,
      "text": "Đầu tư chứng khoán mà không hiểu về chính sách tiền tệ của ngân hàng nhà nước"
    },
    {
      "id": 19,
      "start": 57.88,
      "end": 60.32,
      "text": "Giống như việc bạn lái xe trong đêm bắt đèn vậy"
    },
    {
      "id": 20,
      "start": 60.32,
      "end": 64.08,
      "text": "Thay vì mất thời gian đi nghe ngóng phím hàng 3 chữ cái ở các hội nhóm"
    },
    {
      "id": 21,
      "start": 64.08,
      "end": 66.0,
      "text": "Hãy tập thói quen đọc báo tài chính"
    },
    {
      "id": 22,
      "start": 66.0,
      "end": 68.76,
      "text": "Xem ngân hàng nhà nước đang muốn bơm tiền hay hút tiền"
    },
    {
      "id": 23,
      "start": 68.76,
      "end": 70.64,
      "text": "Nương theo dòng chảy của chùm cuối"
    },
    {
      "id": 24,
      "start": 70.64,
      "end": 72.3,
      "text": "Bạn sẽ luôn ở thế chủ động"
    },
    {
      "id": 25,
      "start": 72.3,
      "end": 76.5,
      "text": "Follow kênh để không bỏ lỡ những câu chuyện kinh tế tài chính đáng chú ý mỗi ngày nhé"
    }
  ],
